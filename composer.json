{
  "name": "forage/theme",
  "description": "Forage Theme",
  "license": "GPLv3",
  "autoload": {
    "psr-4": {
      "Forage\\": "app/"
    }
  },
  "require": {
    "php": "~8.4.27 || ~8.5.12",
    "illuminate/view": "^13",
    "illuminate/support": "^13"
  },
  "scripts": {
    "test": [
      "php tests/assets.php",
      "php tests/blade.php",
      "php tests/template-lifecycle.php",
      "php tests/gravatar.php",
      "php tests/config.php",
      "php tests/prettify.php",
      "php tests/comments.php"
    ],
    "lint": "phpcs",
    "format": "phpcbf"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "config": {
    "platform": {
      "php": "8.4.27"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
