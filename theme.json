{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "46rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "size": "calc(0.375rem + var(--forage-spacing-progress, 0) * (0.44rem - 0.375rem))",
          "name": "2X-Small"
        },
        {
          "slug": "30",
          "size": "calc(0.5rem + var(--forage-spacing-progress, 0) * (0.67rem - 0.5rem))",
          "name": "X-Small"
        },
        {
          "slug": "40",
          "size": "calc(0.75rem + var(--forage-spacing-progress, 0) * (1rem - 0.75rem))",
          "name": "Small"
        },
        {
          "slug": "50",
          "size": "calc(1rem + var(--forage-spacing-progress, 0) * (1.5rem - 1rem))",
          "name": "Medium"
        },
        {
          "slug": "60",
          "size": "calc(1.5rem + var(--forage-spacing-progress, 0) * (2.25rem - 1.5rem))",
          "name": "Large"
        },
        {
          "slug": "70",
          "size": "calc(2.25rem + var(--forage-spacing-progress, 0) * (3.38rem - 2.25rem))",
          "name": "X-Large"
        },
        {
          "slug": "80",
          "size": "calc(3.25rem + var(--forage-spacing-progress, 0) * (5.06rem - 3.25rem))",
          "name": "2X-Large"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true,
    "typography": {
      "fontFamilies": [
        {
          "slug": "body",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica,\n    Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
          "name": "Body"
        }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "var:preset|spacing|50"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    }
  }
}
